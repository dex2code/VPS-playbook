[all]
alpha   ansible_host=alpha.local    ansible_port=22 ansible_user=deployer   ansible_ssh_private_key_file=~/.ssh/deployer_rsa
beta    ansible_host=beta.local     ansible_port=22 ansible_user=deployer   ansible_ssh_private_key_file=~/.ssh/deployer_ed25519
gamma   ansible_host=gamma.local    ansible_port=22 ansible_user=deployer   ansible_ssh_private_key_file=~/.ssh/deployer_rsa
delta   ansible_host=delta.local    ansible_port=22 ansible_user=deployer   ansible_ssh_private_key_file=~/.ssh/deployer_ed25519
omega   ansible_host=omega.local    ansible_port=22 ansible_user=deployer   ansible_ssh_private_key_file=~/.ssh/deployer_rsa

# Конвенция: ролевые группы — с суффиксом _grp. Встроенные группы all и
# ungrouped зарезервированы и суффикс не получают: все хосты определяются
# в [all], роль — в остальных группах.

[one_grp]
alpha
beta

[two_grp]
gamma
delta

[three_grp]
omega
